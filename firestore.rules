rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL SAFETY NET (DEFAULT-DENY CATCH-ALL)
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // STANDALONE ENTITY VALIDATION BLUEPRINTS
    // -------------------------------------------------------------------------
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'language', 'voiceName', 'wakeWordEnabled', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('language' in data) || (data.language is string && data.language.size() <= 32)) &&
             (!('voiceName' in data) || (data.voiceName is string && data.voiceName.size() <= 64)) &&
             (!('wakeWordEnabled' in data) || (data.wakeWordEnabled is bool));
    }

    function isValidDevice(data, userId) {
      return data.keys().hasAll(['deviceId', 'userId', 'platform']) &&
             data.keys().hasOnly(['deviceId', 'userId', 'platform', 'deviceName', 'lastSeen', 'batteryLevel', 'isOnline', 'permissions', 'capabilities']) &&
             data.deviceId is string && data.deviceId.size() <= 128 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.platform in ['android', 'web'] &&
             (!('deviceName' in data) || (data.deviceName is string && data.deviceName.size() <= 128)) &&
             (!('batteryLevel' in data) || (data.batteryLevel is number)) &&
             (!('isOnline' in data) || (data.isOnline is bool)) &&
             (!('permissions' in data) || (data.permissions is map)) &&
             (!('capabilities' in data) || (data.capabilities is list));
    }

    function isValidConversation(data, userId) {
      return data.keys().hasAll(['id', 'userId']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             (!('title' in data) || (data.title is string && data.title.size() <= 256));
    }

    function isValidMessage(data, userId, conversationId) {
      return data.keys().hasAll(['id', 'conversationId', 'userId', 'role', 'content', 'timestamp']) &&
             data.keys().hasOnly(['id', 'conversationId', 'userId', 'role', 'content', 'timestamp', 'agentName', 'intent', 'verified', 'commandExecution']) &&
             data.id is string && data.id.size() <= 128 &&
             data.conversationId == conversationId &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 1048576 &&
             (!('agentName' in data) || (data.agentName is string && data.agentName.size() <= 128)) &&
             (!('intent' in data) || (data.intent is string && data.intent.size() <= 128)) &&
             (!('verified' in data) || (data.verified is bool)) &&
             (!('commandExecution' in data) || (data.commandExecution is map));
    }

    function isValidVoiceSession(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'transcript']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'createdAt', 'durationSeconds', 'transcript']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 256 &&
             data.transcript is list && data.transcript.size() <= 200;
    }

    function isValidMemory(data, userId) {
      return data.keys().hasAll(['category', 'key', 'value', 'userId']) &&
             data.keys().hasOnly(['id', 'category', 'key', 'value', 'userId', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.category in ['preference', 'fact', 'device', 'task'] &&
             data.key is string && data.key.size() <= 128 &&
             data.value is string && data.value.size() <= 1024;
    }

    function isValidAutomation(data, userId) {
      return data.keys().hasAll(['title', 'triggerType', 'triggerDetails', 'actionSummary', 'enabled', 'userId']) &&
             data.keys().hasOnly(['id', 'title', 'triggerType', 'triggerDetails', 'actionSummary', 'enabled', 'userId', 'createdAt', 'updatedAt', 'lastRun']) &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 128 &&
             data.triggerType in ['time', 'countdown', 'recurring', 'device_event'] &&
             data.enabled is bool;
    }

    // -------------------------------------------------------------------------
    // TEST ROUTE FOR PROACTIVE CONNECTION VERIFICATION
    // -------------------------------------------------------------------------
    match /test/{documentId} {
      allow read: if true;
    }

    // -------------------------------------------------------------------------
    // SECURE MATCH TIERS
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().createdAt is timestamp && incoming().updatedAt is timestamp;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().updatedAt is timestamp && incoming().createdAt == existing().createdAt;

      match /devices/{deviceId} {
        allow list: if isOwner(userId) && isValidId(userId);
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(deviceId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(deviceId) && isValidDevice(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(deviceId) && isValidDevice(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(deviceId);
      }

      match /conversations/{conversationId} {
        allow list: if isOwner(userId) && isValidId(userId);
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidConversation(incoming(), userId) && incoming().createdAt is timestamp && incoming().updatedAt is timestamp;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidConversation(incoming(), userId) && incoming().updatedAt is timestamp && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);

        match /messages/{messageId} {
          allow list: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId);
          allow create: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidMessage(incoming(), userId, conversationId) && incoming().timestamp is timestamp;
          allow update: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidMessage(incoming(), userId, conversationId);
          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }

      match /voice_sessions/{sessionId} {
        allow list: if isOwner(userId) && isValidId(userId);
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidVoiceSession(incoming(), userId) && incoming().createdAt is timestamp;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidVoiceSession(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }

      match /memories/{memoryId} {
        allow list: if isOwner(userId) && isValidId(userId);
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(memoryId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidMemory(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(memoryId) && isValidMemory(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(memoryId);
      }

      match /automations/{automationId} {
        allow list: if isOwner(userId) && isValidId(userId);
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(automationId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidAutomation(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(automationId) && isValidAutomation(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(automationId);
      }
    }
  }
}
