# GEMINI_API_KEY: Optional for fallback general text queries.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LIVEKIT REALTIME VOICE AGENT CONFIGURATION
LIVEKIT_URL="wss://livekit.alyaassistant.internal"
LIVEKIT_API_KEY="devkey_alya_livekit_2026"
LIVEKIT_API_SECRET="secret_alya_livekit_key_2026"
LIVEKIT_ROOM="alya-voice-room"
LIVEKIT_AGENT_NAME="Alya Live Voice"

# OPEN-SOURCE STT, LLM, AND TTS MODEL PROVIDERS
STT_PROVIDER="whisper"
STT_MODEL="whisper-large-v3"

LLM_PROVIDER="alya-brain-local"
LLM_MODEL="alya-18yo-v1"

# TTS CONFIGURATION (Use "elevenlabs" for premium voice or "kokoro-tts" / "coqui-tts" for open-source fallbacks)
TTS_PROVIDER="elevenlabs"
TTS_MODEL="eleven_multilingual_v2"
TTS_VOICE="06llJPvI62CjqSWOX9Gp"

# ELEVENLABS PREMIUM VOICES
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"
